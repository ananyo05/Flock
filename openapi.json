{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter Ops REST API",
    "description": "Clean, documented REST API service wrapper in front of legacy Urja Meter Ops web portal. Provides normalized meter listings, details, energy registers with deltas and anomaly flags, distribution transformers, and complete distribution hierarchy trees.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service health check",
        "description": "Returns service status to verify the API server is operational.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/meters": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "List and search meters",
        "description": "Retrieve a paginated list of meters with optional filtering by query, make, status, phase, and DT.",
        "operationId": "list_meters_meters_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring search on meter ID or serial number",
              "title": "Q"
            },
            "description": "Substring search on meter ID or serial number"
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by meter manufacturer (e.g., HPL, Genus, L&T, Allied, Secure)",
              "title": "Make"
            },
            "description": "Filter by meter manufacturer (e.g., HPL, Genus, L&T, Allied, Secure)"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by installation status (Installed, Faulty, Decommissioned)",
              "title": "Status"
            },
            "description": "Filter by installation status (Installed, Faulty, Decommissioned)"
          },
          {
            "name": "phase",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by phase configuration (single, three)",
              "title": "Phase"
            },
            "description": "Filter by phase configuration (single, three)"
          },
          {
            "name": "dt",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by distribution transformer code (e.g., DT-001)",
              "title": "Dt"
            },
            "description": "Filter by distribution transformer code (e.g., DT-001)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-based)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-based)"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Items per page",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Items per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedMetersResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/nearby": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Find nearby meters",
        "description": "Locate meters within a given radius in kilometers using bounding-box prefiltering and Haversine distance.",
        "operationId": "get_nearby_meters_meters_nearby_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "description": "Center latitude in decimal degrees",
              "title": "Lat"
            },
            "description": "Center latitude in decimal degrees"
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "description": "Center longitude in decimal degrees",
              "title": "Lon"
            },
            "description": "Center longitude in decimal degrees"
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 500.0,
              "exclusiveMinimum": 0.0,
              "description": "Search radius in kilometers",
              "default": 5.0,
              "title": "Radius Km"
            },
            "description": "Search radius in kilometers"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NearbyMetersResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get meter detail",
        "description": "Retrieve comprehensive details for a specific meter including installation type, location coordinates, and full distribution hierarchy.",
        "operationId": "get_meter_detail_meters__meter_id__get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}/consumption": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get meter consumption time-series",
        "description": "Fetch energy register readings with ISO-8601 timestamps (+05:30), computed interval deltas, inferred interval, and anomaly flags.",
        "operationId": "get_meter_consumption_meters__meter_id__consumption_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start date in YYYY-MM-DD format",
              "title": "From"
            },
            "description": "Start date in YYYY-MM-DD format"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "End date in YYYY-MM-DD format",
              "title": "To"
            },
            "description": "End date in YYYY-MM-DD format"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transformers": {
      "get": {
        "tags": [
          "Transformers"
        ],
        "summary": "List distribution transformers",
        "description": "Retrieve all distribution transformers with active connected meter counts.",
        "operationId": "list_transformers_transformers_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-based)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-based)"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Items per page",
              "default": 50,
              "title": "Page Size"
            },
            "description": "Items per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransformersListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transformers/{code}": {
      "get": {
        "tags": [
          "Transformers"
        ],
        "summary": "Get transformer by code",
        "description": "Retrieve single transformer by DT code (e.g., DT-007) with active meter count.",
        "operationId": "get_transformer_transformers__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransformerSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/hierarchy": {
      "get": {
        "tags": [
          "Hierarchy"
        ],
        "summary": "Get electrical distribution hierarchy tree",
        "description": "Returns full tree from Zone down to Distribution Transformer (DT) with meter counts per node and audited data quality inconsistencies.",
        "operationId": "get_hierarchy_hierarchy_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HierarchyTreeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/refresh": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Force reload cache",
        "description": "Invalidates cached meter metadata, consumption records, and hierarchy, and forces reload from the portal.",
        "operationId": "refresh_cache_admin_refresh_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsumptionResponse": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id",
            "description": "Unique meter ID",
            "examples": [
              "J100000"
            ]
          },
          "interval": {
            "type": "string",
            "enum": [
              "half_hourly",
              "daily"
            ],
            "title": "Interval",
            "description": "Inferred data resolution",
            "examples": [
              "half_hourly"
            ]
          },
          "from_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "From Date",
            "description": "Start date filter (YYYY-MM-DD)",
            "examples": [
              "2026-06-24"
            ]
          },
          "to_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Date",
            "description": "End date filter (YYYY-MM-DD)",
            "examples": [
              "2026-06-26"
            ]
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/EnergyReading"
            },
            "type": "array",
            "title": "Readings",
            "description": "Chronological energy readings"
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "interval",
          "readings"
        ],
        "title": "ConsumptionResponse",
        "description": "Meter energy consumption time series response."
      },
      "DataQualityIssue": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id",
            "description": "Meter exhibiting inconsistency",
            "examples": [
              "J100044"
            ]
          },
          "issue_type": {
            "type": "string",
            "title": "Issue Type",
            "description": "Category of anomaly",
            "examples": [
              "feeder_mismatch"
            ]
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Detailed description of inconsistency",
            "examples": [
              "DT DT-005 assigned to feeder Feeder 5, previously observed under F-005"
            ]
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "issue_type",
          "description"
        ],
        "title": "DataQualityIssue",
        "description": "Inconsistency identified in portal data."
      },
      "EnergyReading": {
        "properties": {
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "ISO-8601 timestamp with Asia/Kolkata offset (+05:30)",
            "examples": [
              "2026-06-23T23:30:00+05:30"
            ]
          },
          "kwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kwh",
            "description": "Cumulative active energy register in kWh",
            "examples": [
              48438.74
            ]
          },
          "kvah": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kvah",
            "description": "Cumulative apparent energy register in kVAh",
            "examples": [
              52313.84
            ]
          },
          "volt_r": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Volt R",
            "description": "R-phase voltage in volts",
            "examples": [
              226.0
            ]
          },
          "consumption_kwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consumption Kwh",
            "description": "Calculated incremental consumption for interval",
            "examples": [
              0.42
            ]
          },
          "anomaly": {
            "type": "boolean",
            "title": "Anomaly",
            "description": "Flagged true if register decreased (negative consumption delta)",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "timestamp"
        ],
        "title": "EnergyReading",
        "description": "Single energy interval reading with consumption delta and anomaly detection."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Service health status",
            "default": "ok",
            "examples": [
              "ok"
            ]
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "HierarchyItem": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Entity display name",
            "examples": [
              "Jaipur Zone 1"
            ]
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Entity standard identifier code",
            "examples": [
              "Z-01"
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "title": "HierarchyItem",
        "description": "Single level in electrical distribution hierarchy."
      },
      "HierarchyTreeNode": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Node name",
            "examples": [
              "Jaipur Zone 1"
            ]
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Node code",
            "examples": [
              "Z-01"
            ]
          },
          "level": {
            "type": "string",
            "title": "Level",
            "description": "Hierarchy depth: zone, circle, division, subdivision, substation, feeder, dt",
            "examples": [
              "zone"
            ]
          },
          "meter_count": {
            "type": "integer",
            "title": "Meter Count",
            "description": "Total meters installed under this node branch",
            "default": 0,
            "examples": [
              120
            ]
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/HierarchyTreeNode"
            },
            "type": "array",
            "title": "Children",
            "description": "Child nodes in distribution tree"
          }
        },
        "type": "object",
        "required": [
          "name",
          "code",
          "level"
        ],
        "title": "HierarchyTreeNode",
        "description": "Recursive node in distribution hierarchy tree."
      },
      "HierarchyTreeResponse": {
        "properties": {
          "total_meters": {
            "type": "integer",
            "title": "Total Meters",
            "description": "Total meters observed in hierarchy",
            "examples": [
              403
            ]
          },
          "tree": {
            "items": {
              "$ref": "#/components/schemas/HierarchyTreeNode"
            },
            "type": "array",
            "title": "Tree",
            "description": "Top-level zone nodes"
          },
          "data_quality": {
            "items": {
              "$ref": "#/components/schemas/DataQualityIssue"
            },
            "type": "array",
            "title": "Data Quality",
            "description": "Observed structural discrepancies across meters"
          }
        },
        "type": "object",
        "required": [
          "total_meters",
          "tree",
          "data_quality"
        ],
        "title": "HierarchyTreeResponse",
        "description": "Full distribution hierarchy tree and data quality report."
      },
      "Location": {
        "properties": {
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude",
            "description": "Latitude in decimal degrees",
            "examples": [
              26.98325
            ]
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude",
            "description": "Longitude in decimal degrees",
            "examples": [
              75.88163
            ]
          }
        },
        "type": "object",
        "title": "Location",
        "description": "Geographic coordinates."
      },
      "MeterDetailResponse": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id",
            "description": "Unique meter ID",
            "examples": [
              "J100000"
            ]
          },
          "serial_no": {
            "type": "string",
            "title": "Serial No",
            "description": "Manufacturer serial number",
            "examples": [
              "SE33962"
            ]
          },
          "make": {
            "type": "string",
            "title": "Make",
            "description": "Meter manufacturer",
            "examples": [
              "HPL"
            ]
          },
          "phase_type": {
            "type": "string",
            "title": "Phase Type",
            "description": "Phase configuration",
            "examples": [
              "single"
            ]
          },
          "installation_status": {
            "type": "string",
            "title": "Installation Status",
            "description": "Operating status",
            "examples": [
              "Decommissioned"
            ]
          },
          "installation_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Installation Type",
            "description": "Installation type",
            "examples": [
              "Whole Current"
            ]
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ],
            "description": "Meter coordinates"
          },
          "hierarchy": {
            "$ref": "#/components/schemas/StructuredHierarchy",
            "description": "Structured distribution tree levels"
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "serial_no",
          "make",
          "phase_type",
          "installation_status",
          "hierarchy"
        ],
        "title": "MeterDetailResponse",
        "description": "Detailed meter information including coordinates and hierarchy."
      },
      "MeterSummary": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id",
            "description": "Unique meter ID",
            "examples": [
              "J100004"
            ]
          },
          "serial_no": {
            "type": "string",
            "title": "Serial No",
            "description": "Manufacturer serial number",
            "examples": [
              "SE65293"
            ]
          },
          "make": {
            "type": "string",
            "title": "Make",
            "description": "Meter manufacturer",
            "examples": [
              "Genus"
            ]
          },
          "phase_type": {
            "type": "string",
            "title": "Phase Type",
            "description": "Phase configuration (single or three)",
            "examples": [
              "single"
            ]
          },
          "installation_status": {
            "type": "string",
            "title": "Installation Status",
            "description": "Status (Installed, Faulty, Decommissioned)",
            "examples": [
              "Faulty"
            ]
          },
          "dt_code": {
            "type": "string",
            "title": "Dt Code",
